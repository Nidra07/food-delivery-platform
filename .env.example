# Food Delivery Platform - Environment Configuration
# Copy this file to .env and fill in actual values

# ===========================
# DATABASE CONFIGURATION
# ===========================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/food_delivery
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=food_delivery
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

# ===========================
# REDIS CONFIGURATION
# ===========================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================
# JWT & AUTHENTICATION
# ===========================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-12345
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# OTP Configuration
OTP_EXPIRY=600
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3

# ===========================
# EMAIL CONFIGURATION
# ===========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@fooddelivery.com
MAIL_FROM_NAME=Food Delivery Platform

# ===========================
# SMS/OTP PROVIDER
# ===========================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Fallback OTP - For development, set to "console" to log OTPs
OTP_DELIVERY_METHOD=email

# ===========================
# AWS S3 / STORAGE
# ===========================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=food-delivery-uploads
AWS_S3_URL=https://s3.amazonaws.com/food-delivery-uploads
AWS_S3_ACL=public-read

# Alternative: Supabase Storage
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-key
SUPABASE_BUCKET=uploads

# ===========================
# PAYMENT GATEWAY - STRIPE
# ===========================
STRIPE_PUBLIC_KEY=pk_test_your_public_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ===========================
# PAYMENT GATEWAY - RAZORPAY
# ===========================
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ===========================
# APPLICATION SETTINGS
# ===========================
NODE_ENV=development
PORT=3000
WEBSOCKET_PORT=3001
APP_NAME=FoodDelivery
APP_URL=http://localhost:3000
API_VERSION=v1

# ===========================
# FRONTEND URLS
# ===========================
CUSTOMER_APP_URL=http://localhost:8081
PARTNER_APP_URL=http://localhost:8082
RESTAURANT_APP_URL=http://localhost:3002
ADMIN_WEB_URL=http://localhost:3000
OPERATIONS_WEB_URL=http://localhost:3001

# ===========================
# CORS CONFIGURATION
# ===========================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8081,http://localhost:8082
CORS_CREDENTIALS=true

# ===========================
# LOGGING
# ===========================
LOG_LEVEL=debug
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACE_SAMPLE_RATE=0.1

# ===========================
# RATE LIMITING
# ===========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# ===========================
# FILE UPLOAD
# ===========================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,zip
UPLOAD_TEMP_DIR=./uploads/temp

# ===========================
# ADMIN SETTINGS
# ===========================
ADMIN_EMAIL=admin@fooddelivery.com
ADMIN_PASSWORD=ChangeMeInProduction123!

# ===========================
# PAGINATION
# ===========================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
PAGINATION_DEFAULT_SORT=created_at

# ===========================
# FEATURE FLAGS
# ===========================
ENABLE_CASH_PAYMENT=true
ENABLE_WALLET_PAYMENT=false
ENABLE_PROMOTIONS=true
ENABLE_REFERRALS=true
ENABLE_LIVE_TRACKING=true
ENABLE_KYC_VERIFICATION=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=true

# ===========================
# BUSINESS SETTINGS
# ===========================
DEFAULT_COMMISSION_RATE=15.00
DEFAULT_TAX_RATE=5.00
DEFAULT_MIN_ORDER_VALUE=10.00
DELIVERY_FEE_BASE=2.50
DELIVERY_FEE_PER_KM=1.00
SURGE_PRICING_ENABLED=true
SURGE_MULTIPLIER=1.5

# ===========================
# ORDER SETTINGS
# ===========================
ORDER_CANCELLATION_GRACE_PERIOD=300
ORDER_CONFIRMATION_TIMEOUT=600
DELIVERY_TIME_BUFFER_MINUTES=10
MAX_DELIVERY_DISTANCE_KM=50

# ===========================
# GEOCODING
# ===========================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_PLACES_API_KEY=your-google-places-api-key
MAPBOX_TOKEN=your-mapbox-token

# ===========================
# ANALYTICS
# ===========================
ANALYTICS_ENABLED=true
GOOGLE_ANALYTICS_ID=your-ga-id
MIXPANEL_TOKEN=your-mixpanel-token

# ===========================
# MONITORING & ALERTS
# ===========================
MONITORING_ENABLED=false
ALERT_EMAIL=alerts@fooddelivery.com
SLACK_WEBHOOK_URL=your-slack-webhook-url

# ===========================
# SECURITY
# ===========================
BCRYPT_ROUNDS=10
SESSION_SECRET=your-session-secret-key-change-in-production
ENCRYPTION_KEY=your-32-char-encryption-key-1234567890
API_KEY_PREFIX=fop_

# ===========================
# DEVELOPMENT ONLY
# ===========================
DEBUG=false
MOCK_PAYMENT=false
MOCK_LOCATION=false
SEED_DATABASE_ON_START=false
CLEAR_CACHE_ON_START=false

# ===========================
# REDIS CACHE SETTINGS
# ===========================
CACHE_TTL=3600
CACHE_ENABLED=true
CACHE_CLEAR_ON_RESTART=false

# ===========================
# JOB QUEUE SETTINGS
# ===========================
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=5
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=5000

# ===========================
# DEPLOYMENT
# ===========================
DEPLOY_ENV=local
BUILD_ID=
COMMIT_SHA=
BUILD_TIME=
